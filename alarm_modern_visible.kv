#:import dp kivy.metrics.dp

<PrimaryButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.98, 0.99, 1, 1
    font_size: "17sp"
    bold: True
    canvas.before:
        Color:
            rgba: (0.38, 0.40, 0.95, 1) if self.state == "normal" else (0.30, 0.32, 0.82, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18),]

<GhostButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.80, 0.84, 0.90, 1
    font_size: "16sp"
    bold: True
    canvas.before:
        Color:
            rgba: (0.12, 0.16, 0.23, 1) if self.state == "normal" else (0.16, 0.21, 0.30, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18),]

<DangerButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: "18sp"
    bold: True
    canvas.before:
        Color:
            rgba: (0.94, 0.27, 0.27, 1) if self.state == "normal" else (0.76, 0.18, 0.18, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18),]

<ModernInput@TextInput>:
    background_normal: ""
    background_active: ""
    background_color: 0.08, 0.10, 0.16, 1

    foreground_color: 1, 1, 1, 1
    hint_text_color: 0.68, 0.72, 0.82, 1
    cursor_color: 0.13, 0.83, 0.93, 1
    selection_color: 0.13, 0.83, 0.93, 0.35

    font_size: "20sp"
    padding: [dp(16), dp(14), dp(16), dp(12)]
    write_tab: False

<FieldLabel@Label>:
    size_hint_y: None
    height: dp(26)
    color: 0.80, 0.84, 0.90, 1
    font_size: "15sp"
    bold: True
    halign: "left"
    valign: "middle"
    text_size: self.size

<FieldHint@Label>:
    size_hint_y: None
    height: dp(22)
    color: 0.55, 0.62, 0.73, 1
    font_size: "13sp"
    halign: "left"
    valign: "middle"
    text_size: self.size

<MainScreen>:
    orientation: "vertical"
    padding: dp(18)
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: 0.06, 0.09, 0.16, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(154)
        padding: dp(20)
        spacing: dp(6)
        canvas.before:
            Color:
                rgba: 0.12, 0.16, 0.23, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(28),]
            Color:
                rgba: 0.38, 0.40, 0.95, 0.22
            RoundedRectangle:
                pos: self.x + self.width - dp(130), self.y + dp(18)
                size: dp(110), dp(110)
                radius: [dp(55),]
            Color:
                rgba: 0.13, 0.83, 0.93, 0.12
            RoundedRectangle:
                pos: self.x + dp(18), self.y + self.height - dp(60)
                size: dp(160), dp(42)
                radius: [dp(21),]

        Label:
            text: "Будильник с задачами"
            size_hint_y: None
            height: dp(28)
            font_size: "15sp"
            bold: True
            color: 0.80, 0.84, 0.90, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            id: clock_label
            text: "00:00:00"
            size_hint_y: None
            height: dp(66)
            font_size: "48sp"
            bold: True
            color: 0.97, 0.98, 0.99, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            id: date_label
            text: "--.--.----"
            size_hint_y: None
            height: dp(26)
            font_size: "16sp"
            color: 0.58, 0.64, 0.72, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(36)

        Label:
            text: "Мои будильники"
            font_size: "23sp"
            bold: True
            color: 0.97, 0.98, 0.99, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            text: "план на день"
            size_hint_x: None
            width: dp(116)
            font_size: "14sp"
            color: 0.58, 0.64, 0.72, 1
            halign: "right"
            valign: "middle"
            text_size: self.size

    ScrollView:
        do_scroll_x: False
        bar_width: dp(5)
        bar_color: 0.38, 0.40, 0.95, 0.75
        bar_inactive_color: 0.20, 0.25, 0.33, 0.45
        scroll_type: ["bars", "content"]

        GridLayout:
            id: alarms_list
            cols: 1
            spacing: dp(12)
            padding: 0, 0, 0, dp(4)
            size_hint_y: None
            height: self.minimum_height

    PrimaryButton:
        text: "+ Добавить будильник"
        size_hint_y: None
        height: dp(60)
        on_release: app.open_add_alarm_popup()

<AlarmRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(112)
    padding: dp(14)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: 0.07, 0.09, 0.15, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22),]
        Color:
            rgba: 0.20, 0.26, 0.35, 1
        RoundedRectangle:
            pos: self.x, self.y
            size: self.width, dp(1)
            radius: [dp(1),]

    Widget:
        size_hint_x: None
        width: dp(5)
        canvas.before:
            Color:
                rgba: (0.13, 0.83, 0.93, 1) if root.active else (0.38, 0.40, 0.95, 0.38)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(3),]

    BoxLayout:
        orientation: "vertical"
        spacing: dp(4)

        Label:
            text: root.time_text
            size_hint_y: None
            height: dp(40)
            font_size: "32sp"
            bold: True
            color: 0.97, 0.98, 0.99, 1
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            text: root.title
            size_hint_y: None
            height: dp(22)
            font_size: "16sp"
            bold: True
            color: 0.80, 0.84, 0.90, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"

        Label:
            text: root.task_text
            font_size: "14sp"
            color: 0.58, 0.64, 0.72, 1
            halign: "left"
            valign: "top"
            text_size: self.size
            shorten: True
            shorten_from: "right"

    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: dp(82)
        spacing: dp(8)

        ToggleButton:
            text: "Вкл" if self.state == "down" else "Выкл"
            state: "down" if root.active else "normal"
            size_hint_y: None
            height: dp(46)
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            bold: True
            on_state: root.toggle_active(self.state == "down")
            canvas.before:
                Color:
                    rgba: (0.06, 0.73, 0.51, 1) if self.state == "down" else (0.20, 0.26, 0.35, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16),]

        DangerButton:
            text: "Удалить"
            size_hint_y: None
            height: dp(46)
            font_size: "13sp"
            on_release: root.delete_alarm()

<AddAlarmPopup>:
    title: "Добавить будильник"
    size_hint: 0.94, 0.86
    auto_dismiss: False
    background_color: 0.06, 0.09, 0.16, 1
    separator_color: 0.20, 0.26, 0.35, 1
    title_color: 0.97, 0.98, 0.99, 1
    title_size: "20sp"

    BoxLayout:
        orientation: "vertical"
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.06, 0.09, 0.16, 1
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)
            bar_color: 0.38, 0.40, 0.95, 0.80
            bar_inactive_color: 0.20, 0.26, 0.35, 0.45
            scroll_type: ["bars", "content"]

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(18), dp(14), dp(18), dp(10)
                spacing: dp(10)

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(86)
                    padding: dp(16)
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: 0.12, 0.16, 0.23, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(22),]

                    Label:
                        text: "Новый сигнал"
                        size_hint_y: None
                        height: dp(30)
                        font_size: "22sp"
                        bold: True
                        color: 0.97, 0.98, 0.99, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Label:
                        text: "Укажи время и задачу, которую нужно выполнить после сигнала."
                        font_size: "14sp"
                        color: 0.58, 0.64, 0.72, 1
                        halign: "left"
                        valign: "top"
                        text_size: self.size

                FieldLabel:
                    text: "Время"

                ModernInput:
                    id: time_input
                    hint_text: "Например: 07:30"
                    multiline: False
                    size_hint_y: None
                    height: dp(58)
                    input_filter: None

                FieldHint:
                    text: "Формат строго ЧЧ:ММ"

                FieldLabel:
                    text: "Название"

                ModernInput:
                    id: title_input
                    hint_text: "Например: Утро"
                    multiline: False
                    size_hint_y: None
                    height: dp(54)

                FieldLabel:
                    text: "Задача"

                ModernInput:
                    id: task_input
                    hint_text: "Например: Выпить воду, сделать зарядку, проверить план"
                    multiline: True
                    size_hint_y: None
                    height: dp(150)

                FieldHint:
                    text: "Поле большое, а всё окно теперь можно прокручивать вверх и вниз."

                Label:
                    id: error_label
                    text: ""
                    size_hint_y: None
                    height: dp(44)
                    color: 1, 0.45, 0.45, 1
                    font_size: "14sp"
                    bold: True
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(76)
            padding: dp(18), 0, dp(18), dp(18)
            spacing: dp(10)

            GhostButton:
                text: "Отмена"
                on_release: root.dismiss()

            PrimaryButton:
                text: "Сохранить"
                on_release: app.add_alarm_from_popup(root)

<RingPopup>:
    title: "Будильник"
    size_hint: 0.92, None
    height: dp(330)
    auto_dismiss: False
    background_color: 0.06, 0.09, 0.16, 1
    separator_color: 0.20, 0.26, 0.35, 1
    title_color: 0.97, 0.98, 0.99, 1
    title_size: "20sp"

    BoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(16)
        canvas.before:
            Color:
                rgba: 0.06, 0.09, 0.16, 1
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            padding: dp(18)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 0.12, 0.16, 0.23, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(24),]

            Label:
                id: ring_title
                text: "Будильник"
                size_hint_y: None
                height: dp(48)
                font_size: "24sp"
                bold: True
                color: 0.97, 0.98, 0.99, 1
                halign: "center"
                valign: "middle"
                text_size: self.size

            Label:
                id: ring_task
                text: "Задача"
                font_size: "18sp"
                color: 0.80, 0.84, 0.90, 1
                halign: "center"
                valign: "middle"
                text_size: self.size

        DangerButton:
            text: "Остановить"
            size_hint_y: None
            height: dp(58)
            on_release: root.stop_alarm()
